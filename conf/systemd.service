[Unit]
Description=Kriterio Vault sync server (%i)
After=network.target postgresql.service

[Service]
# Un solo proceso a propósito: el backup automático y el push de
# sincronización usan un scheduler en memoria (APScheduler); con más de un
# worker cada proceso lanzaría el suyo y se duplicarían backups y envíos.
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/backend
EnvironmentFile=__INSTALL_DIR__/backend/.env
ExecStart=__INSTALL_DIR__/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port __PORT__
Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/__APP__/__APP__.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
