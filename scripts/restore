#!/bin/bash
# No probado contra una instancia YunoHost real — revisar con --debug.
source _common.sh
source /usr/share/yunohost/helpers

ynh_abort_if_errors

ynh_script_progression "Restaurando los ficheros de la aplicación..."
ynh_restore_file --origin_path="$install_dir"

ynh_script_progression "Reconstruyendo el entorno virtual de Python..."
python3 -m venv "$install_dir/backend/venv"
"$install_dir/backend/venv/bin/pip" install --upgrade pip --quiet
"$install_dir/backend/venv/bin/pip" install --quiet -r "$install_dir/backend/requirements.txt"

ynh_script_progression "Restaurando la base de datos PostgreSQL..."
ynh_psql_setup_db --db_user=$db_name --db_name=$db_name --db_pwd=$db_pwd
ynh_psql_execute_file_as_root --database=$db_name --file=./db.sql

ynh_script_progression "Restaurando la configuración de NGINX y systemd..."
ynh_restore_file --origin_path="/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore_file --origin_path="/etc/systemd/system/$app.service"
systemctl daemon-reload

ynh_script_progression "Asegurando permisos..."
chown -R "$app:$app" "$install_dir"
chmod 600 "$install_dir/backend/.env"
mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"

ynh_script_progression "Arrancando la aplicación..."
ynh_systemd_action --service_name=$app --action="start" \
    --line_match="Application startup complete" --log_path="/var/log/$app/$app.log"

ynh_script_progression "Restauración completada" --last
